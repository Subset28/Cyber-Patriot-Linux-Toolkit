# Edit per image. Anything you leave commented is filled from the README
# (users, admins, critical services) or asked for when the script runs.

# ADMINS="benjamin jpearson"        # overrides the README admin list
# USERS=""                          # overrides the README user list
# SERVICES=""                       # overrides the README critical services
# NEW_ADMINS="edarby"               # new admin accounts (forced password change)
# Every authorized account gets a generated password, saved to the run folder (new-passwords.txt).

: "${ALLOW_TCP_PORTS:=22}"          # ports to allow through ufw, in addition to SSH
: "${PASS_MAX_DAYS:=90}"
: "${PASS_MIN_DAYS:=7}"
: "${PASS_WARN_AGE:=7}"
: "${PASS_MIN_LEN:=12}"
: "${FAILLOCK_DENY:=5}"
: "${FAILLOCK_UNLOCK:=600}"
: "${MEDIA_EXT:=mp3|mp4|mov|avi|wav|flac|ogg|m4a|mkv|wma|aac}"
: "${MEDIA_DIRS:=music|downloads|videos}"   # folder names (regex) where media is deleted
: "${BAD_PKGS:=wireshark zangband vsftpd pure-ftpd proftpd-basic manaplus gameconqueror nmap zenmap john hydra nikto aircrack-ng ophcrack netcat-traditional telnet rsh-client rsh-server}"
: "${PROTECTED_PKGS:=chromium chromium-browser firefox lightdm openssh-server}"

# Standard (non-admin) accounts to create. Each is asked for a password.
NewUsers=()                         # e.g. ("belethor")

# user:group pairs to add to a group, e.g. ("candace:firesidegirls")
GroupMembers=()

# 1 = unauthorized accounts are deleted with their home folder; 0 = home folder kept
: "${DeleteUnauthorizedHomes:=1}"
